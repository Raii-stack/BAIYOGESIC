# Server
PORT=3000

# Supabase server-side credentials. Never expose SUPABASE_KEY to browser code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-server-side-supabase-key

# PostgreSQL connection string used when SET LOCAL app.username must share
# a transaction/connection with the authenticated query.
DATABASE_URL=postgres://postgres:your-password@your-host:5432/postgres?sslmode=require

# Use a long random value in deployment; never commit the real secret.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h

# Optional absolute API origin for deployments. Leave empty to use same-origin /api.
VITE_API_BASE_URL=

# Local Express backend target used by the Vite development proxy.
VITE_API_PROXY_TARGET=http://localhost:3000
