{
  "name": "hope-inc-erp",
  "version": "1.0.0",
  "private": true,
  "description": "HOPE, Inc. ERP API and React frontend",
  "main": "server.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:frontend": "vite",
